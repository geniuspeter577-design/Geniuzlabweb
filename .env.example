# Local development
GENIUZLAB_DEBUG=True
GENIUZLAB_SECRET_KEY=replace-with-a-local-only-secret
GENIUZLAB_ALLOWED_HOSTS=localhost,127.0.0.1

# Production core settings
# GENIUZLAB_DEBUG=False
# GENIUZLAB_SECRET_KEY=generate-a-unique-secret
# GENIUZLAB_ALLOWED_HOSTS=example.com
# GENIUZLAB_DATABASE_URL=postgres://user:password@host:5432/database
# GENIUZLAB_CSRF_TRUSTED_ORIGINS=https://example.com
# GENIUZLAB_SECURE_SSL_REDIRECT=True

# Email
# GENIUZLAB_EMAIL_HOST=smtp.example.com
# GENIUZLAB_EMAIL_PORT=587
# GENIUZLAB_EMAIL_USE_TLS=True
# GENIUZLAB_EMAIL_HOST_USER=
# GENIUZLAB_EMAIL_HOST_PASSWORD=
# GENIUZLAB_DEFAULT_FROM_EMAIL=GeniuzLab <no-reply@example.com>

# Payments
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=

# VTpass VTU
# VTPASS_API_KEY=
# VTPASS_SECRET_KEY=
# VTPASS_PUBLIC_KEY=
# VTPASS_LIVE_MODE=False
# FEATURE_VTU_ENABLED=False

# AI providers
